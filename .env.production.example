# =====================================
# APPLICATION CONFIGURATION
# =====================================

NODE_ENV=production
DEPLOYMENT_MODE=cloud
PORT=5000

# =====================================
# FRONTEND CONFIGURATION
# =====================================

CLIENT_URL=https://your-domain.com
VITE_API_BASE_URL=/api/v1

# =====================================
# DATABASE CONFIGURATION
# =====================================

MONGODB_URI=

# =====================================
# AUTHENTICATION
# =====================================

JWT_SECRET=

# =====================================
# AI PROVIDERS
# =====================================

GROQ_API_KEY=
GEMINI_API_KEY=

LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_ENABLED=true

# =====================================
# REDIS CONFIGURATION
# =====================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =====================================
# BACKGROUND PROCESSING
# =====================================

QUEUE_PREFIX=careerlens
QUEUE_WORKER_CONCURRENCY=2

# =====================================
# REVERSE PROXY
# =====================================

TRUSTED_PROXY=172.30.50.10

# =====================================
# LOGGING AND AI CACHE
# =====================================

LOG_LEVEL=info
HF_HOME=/app/cache